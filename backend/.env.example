# Copy to backend/.env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase → Project Settings → API. Use the service_role key (backend only).
SUPABASE_URL=
SUPABASE_KEY=

# Front-end origins allowed by CORS (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:3000
# Optional: allow Vercel preview deploys, e.g. https://trusttrade-[a-z0-9-]+\.vercel\.app
CORS_ORIGIN_REGEX=

# auto | supabase | memory
STORE_BACKEND=auto
AUTO_SEED=true

# Practice prices: yfinance | none. New wallets start N trading days back so fast-forward can replay history.
PRICE_SOURCE=yfinance
PRACTICE_START_OFFSET_DAYS=20

# The one Content Admin. With Supabase it is created in Supabase Auth on startup (role admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Long random string that signs admin sessions, e.g.  python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_TOKEN_SECRET=
